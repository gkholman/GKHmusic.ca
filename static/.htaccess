# GKHmusic.ca — Referrer tracking redirects
# Each /r/<token> path is a unique inbound referrer link.
# Apache logs the hit before issuing the 302, so GoAccess
# reports each token as a distinct URI with its own hit count.
#
# To add a referrer: append a line following the pattern below.
# To remove a referrer: comment out or delete the line.

RewriteEngine On

###############################################################################
#
# AS A RULE OF THUMB: outbound redirects include hyphens, inbound do not
#
###############################################################################


# Inbound from projecTEMBO (projectembo.org) — NGO fundraising page
RewriteRule ^r/tembo/?$ / [R=302,L]

# Inbound from business card "Listen" QR code
RewriteRule ^r/c/?$ /index.html#listen [R=302,NE,L]

# Inbound from CraneSoftwrights.com
RewriteRule ^r/crane/?$ /index.html [R=302,L]

# Inbound from Instagram
RewriteRule ^r/i/?$ /index.html [R=302,L]

# Inbound from LinkedIn
RewriteRule ^r/l/?$ /index.html [R=302,L]



# Inbound if visitor misses hash in the URI:
RewriteRule ^top/?$          /index.html#top          [R=302,NE,L]
RewriteRule ^about/?$        /index.html#about        [R=302,NE,L]
RewriteRule ^booking/?$      /index.html#booking      [R=302,NE,L]
RewriteRule ^book/?$         /index.html#book         [R=302,NE,L]
RewriteRule ^listen/?$       /index.html#listen       [R=302,NE,L]
RewriteRule ^offer/?$        /index.html#offer        [R=302,NE,L]
RewriteRule ^repertoire/?$   /index.html#offer        [R=302,NE,L]
RewriteRule ^availability/?$ /index.html#availability [R=302,NE,L]
RewriteRule ^schedule/?$     /index.html#availability [R=302,NE,L]
RewriteRule ^gallery/?$      /index.html#highlights   [R=302,NE,L]
RewriteRule ^highlights/?$   /index.html#highlights   [R=302,NE,L]
RewriteRule ^payment/?$      /index.html#payment      [R=302,NE,L]
RewriteRule ^tips?/?$        /index.html#payment      [R=302,NE,L]
RewriteRule ^contact/?$      /index.html#contact      [R=302,NE,L]
RewriteRule ^nashipai/?$     /index.html#nashipai     [R=302,NE,L]



# Outbound to projecTEMBO information page
RewriteRule ^r/info-tembo/?$ https://www.projectembo.org [R=302,L]

# Outbound to projecTEMBO donation page
RewriteRule ^r/donate-tembo/?$ https://give-can.keela.co/ken-holman-stand-alone [R=302,L]

# Outbound to ROSSS.ca information page
RewriteRule ^r/info-rosss/?$ https://ROSSS.ca [R=302,L]

# Outbound to LinkedIn
RewriteRule ^r/info-linkedin/?$ https://www.linkedin.com/in/gkholman/ [R=302,L]

# Outbound to Facebook
RewriteRule ^r/info-facebook/?$ https://facebook.com/g.ken.holman [R=302,L]

# Outbound to McKay Guitars
RewriteRule ^r/info-mckay/?$ https://McKayGuitars.ca [R=302,L]

# Outbound to Skinner Leather
RewriteRule ^r/info-skinner/?$ https://www.facebook.com/skinnerleather [R=302,L]

# Outbound to 2026-09 sampler
RewriteRule ^r/sampler-202609/?$ https://youtube.com/shorts/MSbxKiuSqWg [R=302,L]

